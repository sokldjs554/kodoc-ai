# KoDoc 설정 (.env 로 복사해서 사용)
# 모든 값은 KODOC_ 접두사의 환경변수로도 지정 가능

# LLM — OpenAI 호환 서버 (vLLM serve, 또는 임의의 호환 엔드포인트)
KODOC_LLM_BASE_URL=http://localhost:8000/v1
KODOC_LLM_API_KEY=EMPTY
KODOC_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# VLM — 문서 이미지 파싱용 (vLLM serve Qwen/Qwen2.5-VL-7B-Instruct)
KODOC_VLM_BASE_URL=http://localhost:8001/v1
KODOC_VLM_API_KEY=EMPTY
KODOC_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# temperature — 값을 비우면 요청에서 아예 제외한다.
# OpenAI 호환 API라도 지원 파라미터는 모델마다 다르다. 최신 Claude 모델
# (claude-sonnet-5, claude-opus-5 등)은 temperature를 받으면 400을 돌려주므로
# 그런 모델을 쓸 때는 아래 두 줄의 값을 비워 둘 것.
KODOC_LLM_TEMPERATURE=0.2
KODOC_VLM_TEMPERATURE=0.0

# 검색/인덱싱
# hash  : 의존성 없는 결정적 임베더 (데모/테스트용, CPU)
# bge-m3: BAAI/bge-m3 (pip install -e ".[embeddings]" 필요)
KODOC_EMBEDDER=hash
KODOC_CHUNK_SIZE=600
KODOC_CHUNK_OVERLAP=120
KODOC_TOP_K=5
KODOC_INDEX_DIR=./index
